<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>記憶実験</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f5f5;color:#222;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
main{max-width:760px;margin:auto;padding:18px 14px}
.card{background:#fff;border-radius:16px;padding:22px;box-shadow:0 2px 12px rgba(0,0,0,.08)}
.hidden{display:none!important}
h1,h2{margin-top:0}
.center{text-align:center}
button{appearance:none;border:0;border-radius:11px;background:#222;color:#fff;font-size:18px;padding:13px 24px;cursor:pointer}
button:disabled{opacity:.5}
.notice{background:#f0f0f0;padding:14px;border-radius:10px;line-height:1.7}
#stimulus{display:block;width:100%;max-height:70vh;object-fit:contain;margin:15px auto}
.timer{font-size:22px;text-align:center;font-variant-numeric:tabular-nums}
.calcgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:18px}
.calc{padding:14px 3px;background:#eee;border-radius:9px;text-align:center;font-size:20px}
.q{border-bottom:1px solid #ddd;padding:18px 0}
.choice{display:flex;gap:10px;margin:10px 0}
.choice label,.conf label{border:1px solid #ccc;border-radius:9px;padding:9px 14px}
.conf{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
.conf input{display:none}
.conf label:has(input:checked){background:#222;color:#fff;border-color:#222}
.small{font-size:13px;color:#666}
.error{color:#b00020}
.status{padding:12px;border-radius:10px;background:#f0f0f0;margin-top:12px}
</style>
</head>
<body>
<main>
<section id="start" class="card">
<h1>記憶実験</h1>
<div class="notice">
<p>これから画像を使った記憶実験を行います。</p>
<p>準備ができたら「開始」を押してください。</p>
</div>
<br>
<button id="startBtn" onclick="startExperiment()">開始</button>
</section>

<section id="pre" class="card hidden">
<h2>実験前の説明</h2>
<div class="notice">これから多くのものが写った街中の画像を30秒間出します。</div>
<br>
<button onclick="showImage()">次へ</button>
</section>

<section id="image" class="card hidden center">
<h2>画像を見てください</h2>
<img id="stimulus" src="stimulus.jpg" alt="実験画像">
<div id="imageTimer" class="timer">30.0秒</div>
</section>

<section id="calc" class="card hidden">
<h2>計算問題</h2>
<p>以下の計算問題を見てください。30秒後に自動的に次へ進みます。</p>
<div id="calcgrid" class="calcgrid"></div>
<div id="calcTimer" class="timer"></div>
</section>

<section id="test" class="card hidden">
<h2>記憶テスト</h2>
<p>画像を思い出して答えてください。各問題について、<strong>回答と自信度の両方</strong>を選択してください。</p>
<div id="questions"></div>
<p id="error" class="error"></p>
<button onclick="submitTest()">回答を送信</button>
</section>

<section id="done" class="card hidden center">
<h2>終了</h2>
<p>ご協力ありがとうございました。</p>
<div id="saveStatus" class="status">回答データを保存しています。</div>
</section>
</main>

<script src="config.js"></script>
<script>
const QUESTIONS=[["水色の自転車はありましたか？", true], ["緑色の建物はありましたか？", true], ["黄色の標識はありましたか？", true], ["ゴミ袋は4つありましたか？", true], ["寝ている猫はいましたか？", true], ["赤い虫はいましたか？", true], ["空に雲は2つありましたか？", false], ["電柱は3つありましたか？", false], ["太陽はありましたか？", false], ["男性は4人いましたか？", false], ["黒い鳥は1匹いましたか？", false]];
const with_info="with_info";
let imageStart=0, calcStart=0, submitted=false;

function show(id){
  document.querySelectorAll("section").forEach(s=>s.classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
  window.scrollTo(0,0);
}
function newSessionId(){
  if(window.crypto && crypto.randomUUID) return crypto.randomUUID();
  return Date.now().toString(36)+"-"+Math.random().toString(36).slice(2);
}
const sessionId=newSessionId();

function startExperiment(){
  document.getElementById("startBtn").disabled=true;
  if(with_info==="with_info") show("pre");
  else showImage();
}

function showImage(){
  show("image");
  const img=document.getElementById("stimulus");
  img.style.visibility="visible";
  imageStart=performance.now();
  const end=imageStart+30000;
  const timer=setInterval(()=>{
    const left=Math.max(0,end-performance.now());
    document.getElementById("imageTimer").textContent=(left/1000).toFixed(1)+"秒";
    if(left<=0){
      clearInterval(timer);
      img.style.visibility="hidden";
      startCalc();
    }
  },50);
}

function startCalc(){
  show("calc");
  calcStart=performance.now();
  const grid=document.getElementById("calcgrid");
  grid.innerHTML="";
  for(let i=0;i<20;i++){
    const a=1+Math.floor(Math.random()*9);
    const b=1+Math.floor(Math.random()*9);
    const d=document.createElement("div");
    d.className="calc";
    d.textContent=`${a} ＋ ${b} ＝`;
    grid.appendChild(d);
  }
  const end=calcStart+30000;
  const timer=setInterval(()=>{
    const left=Math.max(0,end-performance.now());
    document.getElementById("calcTimer").textContent=(left/1000).toFixed(1)+"秒";
    if(left<=0){
      clearInterval(timer);
      buildTest();
    }
  },50);
}

function buildTest(){
  show("test");
  const box=document.getElementById("questions");
  box.innerHTML="";
  QUESTIONS.forEach((q,i)=>{
    const d=document.createElement("div");
    d.className="q";
    d.innerHTML=`
      <p><strong>Q${i+1}. ${q[0]}</strong></p>
      <div class="choice">
        <label><input type="radio" name="a${i}" value="true"> ○</label>
        <label><input type="radio" name="a${i}" value="false"> ×</label>
      </div>
      <div><strong>自信度</strong>（0＝全く自信がない、5＝とても自信がある）</div>
      <div class="conf">
        ${[0,1,2,3,4,5].map(n=>`<label><input type="radio" name="c${i}" value="${n}">${n}</label>`).join("")}
      </div>`;
    box.appendChild(d);
  });
}

async function submitTest(){
  if(submitted) return;
  const answers=[];
  for(let i=0;i<QUESTIONS.length;i++){
    const a=document.querySelector(`input[name="a${i}"]:checked`);
    const c=document.querySelector(`input[name="c${i}"]:checked`);
    if(!a || !c){
      document.getElementById("error").textContent=`Q${i+1}の回答と自信度の両方を選択してください。`;
      return;
    }
    const answer=a.value==="true";
    answers.push({
      question:QUESTIONS[i][0],
      answer:answer?"○":"×",
      correct:answer===QUESTIONS[i][1],
      confidence:Number(c.value)
    });
  }

  submitted=true;
  show("done");
  const totalCorrect=answers.filter(x=>x.correct).length;
  const payload={
    session_id:sessionId,
    condition:with_info,
    image_duration_ms:Math.round(performance.now()-imageStart),
    calculation_duration_ms:Math.round(performance.now()-calcStart),
    answers:answers,
    total_correct:totalCorrect
  };

  if(!APPS_SCRIPT_URL || APPS_SCRIPT_URL.includes("ここに")){
    document.getElementById("saveStatus").textContent=
      "実験は終了しました。まだGoogleスプレッドシートの接続先が設定されていないため、回答は自動保存されていません。";
    return;
  }

  try{
    await fetch(APPS_SCRIPT_URL,{
      method:"POST",
      mode:"no-cors",
      headers:{"Content-Type":"text/plain;charset=utf-8"},
      body:JSON.stringify(payload)
    });
    document.getElementById("saveStatus").textContent="回答データを送信しました。";
  }catch(e){
    document.getElementById("saveStatus").textContent=
      "回答データの送信に失敗しました。通信環境を確認してください。";
  }
}
</script>
</body>
</html>
